# Skopiuj do .env (plik jest w .gitignore) albo ustaw jako zmienne środowiskowe użytkownika.
# NIGDY nie commituj prawdziwych wartości (Konstytucja, Zasada I).

# --- Trello (serwer MCP dla Claude Code, zob. docs/kanban-trello.md) ---
# Klucz API: https://trello.com/power-ups/admin -> Twój Power-Up -> API key
TRELLO_API_KEY=
# Token użytkownika wygenerowany dla powyższego klucza (link "Token" obok API key)
TRELLO_TOKEN=
# ID tablicy projektu (fragment URL tablicy lub wynik narzędzia list_boards); opcjonalne
TRELLO_BOARD_ID=
