# Copy to .env (the file is in .gitignore) or set as user environment variables.
# NEVER commit real values (Constitution, Principle I).

# --- Trello (only for scripts/sync-trello.ps1; Claude uses the Trello connector, see docs/kanban-trello.md) ---
# API key: https://trello.com/power-ups/admin -> your Power-Up -> API key
TRELLO_API_KEY=
# User token generated for the key above (the "Token" link next to the API key)
TRELLO_TOKEN=
# Project board ID (fragment of the board URL or the result of the list_boards tool); optional
TRELLO_BOARD_ID=

# --- Stripe (test mode ONLY) ---
# To work on US1-US3 without a Stripe account, dummies are enough:
#   STRIPE_SECRET_KEY=sk_test_dummy
#   STRIPE_WEBHOOK_SECRET=whsec_dummy
# (the application starts; placing an order returns "Payment temporarily unavailable" - 503).
# Secret key from Dashboard -> Developers -> API keys. Only sk_test_... - an sk_live_... key blocks startup.
STRIPE_SECRET_KEY=
# Webhook signing secret whsec_... printed by `stripe listen` (docker compose --profile stripe up stripe-cli)
STRIPE_WEBHOOK_SECRET=
# Optional: Stripe API base URL override (e.g. http://localhost:9 to simulate an unreachable provider)
STRIPE_API_BASE=

# --- Database (local SQL Server from compose.yaml) ---
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=shop;encrypt=true;trustServerCertificate=true
DB_USER=sa
# Any strong password (SQL Server requires upper/lower case letters, digits and symbols)
DB_PASSWORD=

# --- Application ---
# Public address of the frontend (Stripe success/cancel URLs are built from it)
APP_BASE_URL=http://localhost:5173

# --- Observability ---
# Required by `docker compose up` for Grafana; do not use admin/admin
GRAFANA_ADMIN_PASSWORD=
